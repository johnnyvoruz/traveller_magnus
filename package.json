{
  "name": "traveller-voyage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "test:api:all": "node scripts/test_api_all.mjs",
    "check": "node scripts/check_manifesto.js",
    "typecheck": "tsc --noEmit -p apps/api",
    "rules:gen": "node scripts/gen_rules_esm.js",
    "truth:local": "node tools/truth/build.js v5",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run rules:gen && npm run names:gen && npm --workspace apps/web run build",
    "deploy": "npm run build && npm --workspace apps/api run deploy",
    "xauth": "node scripts/xauth.js",
    "names:gen": "node scripts/gen_names_esm.js",
    "deploy:ci": "npx wrangler d1 migrations apply voyage --remote --config apps/api/wrangler.toml && npx wrangler deploy --config apps/api/wrangler.toml",
    "preview:ci": "npx wrangler versions upload --config apps/api/wrangler.toml"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "0.2.11",
    "@vue/compiler-sfc": "3.5.44",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}
