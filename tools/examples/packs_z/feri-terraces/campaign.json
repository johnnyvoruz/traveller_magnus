    {
      "id": "cr_a3000000-0000-4000-8000-000000000003",
      "type": "person",
      "kind": "factor",
      "name": "Ilse Marrow",
      "summary": "The Combine's factor at the downport.",
      "details": "Ilse books every hold the Combine fills. She is polite, exact and short of time in the harvest weeks. She keeps a list of crews who were late once, and she does not hire them again. Hook: she has a second contract she will not put through the Combine's books.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/2005",
