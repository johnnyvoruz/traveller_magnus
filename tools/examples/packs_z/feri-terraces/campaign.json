    },
    {
      "id": "cr_a3000000-0000-4000-8000-000000000002",
      "type": "organization",
      "kind": "growers' combine",
      "name": "Terrace Growers' Combine",
      "summary": "The growers who own most of the terraces and sell as one.",
      "details": "The Combine sets one price for the whole harvest and books ships months ahead. It pays well and on time. It does not forgive a late arrival. Hook: the Combine needs a ship that can carry a cold cargo and leave on the day the fruit is picked.",
      "tags": [
        "example"
      ],
      "anchor": {
