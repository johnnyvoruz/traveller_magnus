    {
      "id": "cr_a3000000-0000-4000-8000-000000000001",
      "type": "place",
      "kind": "farmland",
      "name": "The Orchard Terraces",
      "summary": "Stepped orchards on the slopes above the Feri downport.",
      "details": "The terraces climb the hills behind the port in long green steps. Pickers work them by hand, and the fruit goes up to orbit in sealed crates the same day. Visitors are welcome on the lower steps. Hook: one upper terrace has been fenced off since last season, and nobody at the port will say who paid for the fence.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/2005",
        "bodyKey": "w1"
      },
