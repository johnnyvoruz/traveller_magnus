    {
      "id": "cr_a3000000-0000-4000-8000-000000000007",
      "type": "place",
      "kind": "relay",
      "name": "The A-IV-b relay",
      "summary": "An automated relay on the second moon of the fourth planet.",
      "details": "The relay passes traffic between the belt claims and the downport. It needs a visit every few months to clear its antennas. Hook: the relay holds a copy of every beacon call, including the last calls from the quiet claim.",
      "tags": [
        "example"
      ],
