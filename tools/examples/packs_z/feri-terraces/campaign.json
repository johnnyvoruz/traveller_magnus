    {
      "id": "cr_a3000000-0000-4000-8000-000000000008",
      "type": "note",
      "kind": "referee note",
      "name": "Feri: using this pack",
      "summary": "How the Feri records fit together.",
      "details": "The Combine and the belt are separate halves of the system: one ships fruit, the other ships ore. Ilse links them. The sealed case and the quiet beacon are the same story; decide what is in the case before the crew opens it.",
      "tags": [
        "example"
