    {
      "id": "cr_a3000000-0000-4000-8000-000000000004",
      "type": "place",
      "kind": "claim field",
      "name": "The Second Belt claims",
      "summary": "Mining claims staked across the second belt of the system.",
      "details": "Small outfits work the rocks of the second belt under claims filed at the downport. Most claims are marked with a beacon that answers on a fixed call. Hook: a beacon on one of the oldest claims has stopped answering.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/2005",
        "bodyKey": "w3"
      },
