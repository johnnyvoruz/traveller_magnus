      "updatedAt": "2026-10-14T18:00:00.000Z",
      "deleted": false
    },
    {
      "id": "cr_a3000000-0000-4000-8000-000000000005",
      "type": "person",
      "kind": "prospector",
      "name": "Doran Vey",
      "summary": "A belter who holds an old claim in the second belt.",
      "details": "Doran has worked the same claim for years and talks about it as if it were a person. He comes down to the port to sell ore and to argue with the claims office. Hook: his claim is the one whose beacon went quiet, and he says he was not there when it stopped.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
