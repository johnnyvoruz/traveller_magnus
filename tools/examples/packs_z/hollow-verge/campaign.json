    },
    {
      "id": "cr_a4000000-0000-4000-8000-000000000002",
      "type": "person",
      "kind": "beacon keeper",
      "name": "Tamsin Reeve",
      "summary": "The night keeper at Verge Lantern.",
      "details": "Tamsin has kept the night log for a long time and trusts it more than she trusts most captains. She will trade news for news. Hook: she wants someone to find the ship that was logged and never docked.",
      "tags": [
        "example"
      ],
