    },
    {
      "id": "cr_a4000000-0000-4000-8000-000000000004",
      "type": "person",
      "kind": "survey clerk",
      "name": "Corin Hale",
      "summary": "The clerk who signs survey contracts for the office.",
      "details": "Corin reads every survey that comes in and checks it against the last one. He is careful and slow, and he asks for the raw logs as well as the summary. Hook: two surveys of the same system disagree, and he wants a third.",
      "tags": [
        "example"
      ],
