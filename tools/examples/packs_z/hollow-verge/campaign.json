    {
      "id": "cr_a4000000-0000-4000-8000-000000000005",
      "type": "job",
      "kind": "survey",
      "name": "A third survey",
      "summary": "Survey the far system of the Verge and settle a disagreement.",
      "details": "Two crews brought back surveys of the same system, and they do not match. Corin Hale will pay for a third survey, with full logs, from a crew that has not seen either of the first two.",
      "tags": [
        "example"
      ],
