    {
      "id": "cr_a4000000-0000-4000-8000-000000000001",
      "type": "place",
      "kind": "beacon station",
      "name": "Verge Lantern",
      "summary": "A crewed beacon station at the near edge of the Hollow Verge.",
      "details": "Ships that come into the Verge call the Lantern first. The keepers log every arrival and sell fuel and news to anyone who asks. Hook: the night log shows one more arrival than the station has berths for.",
      "tags": [
        "example"
      ],
