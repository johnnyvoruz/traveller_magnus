    {
      "id": "cr_a4000000-0000-4000-8000-000000000003",
      "type": "organization",
      "kind": "survey office",
      "name": "Verge Survey Office",
      "summary": "A small office that pays for charts of the Verge.",
      "details": "The office buys survey data from any crew that brings it in clean. Its charts of the Verge are short of detail, and it says so. Hook: it pays a bonus for a first full survey of any system it has not charted.",
      "tags": [
        "example"
      ],
