    {
      "id": "cr_c1000001-0000-4000-8000-000000000008",
      "type": "person",
      "kind": "broker",
      "name": "Odette Parr",
      "summary": "Odette Parr sells the names of people who are in the highport tonight.",
      "details": "Odette works from The Quiet Lock. She will tell a referee who met whom, in exchange for an introduction, not for a price. Hook: she knows who sent Harun's crate, and she knows Nia Calder is already looking. Do not name a fee. Pay: the referee's call.",
      "tags": [],
