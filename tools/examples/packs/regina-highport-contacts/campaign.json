      "updatedAt": "2026-10-14T00:00:00.000Z",
      "deleted": false
    },
    {
      "id": "cr_c1000001-0000-4000-8000-000000000003",
      "type": "person",
      "kind": "clerk",
      "name": "Ivo Marsh",
      "summary": "Ivo Marsh files scout-base supply notes at the Regina highport.",
      "details": "Ivo sits at The Amber Berth and trades fuel times for gossip. He can say which scout ships are in, and which berths they left empty. Hook: one berth has been empty for three watches, and the ship that should be there is still on his list. He has not told the base.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
      "when": null,
      "visibility": "players",
      "playerNotes": null,
