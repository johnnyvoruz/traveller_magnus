      "deleted": false
    },
    {
      "id": "cr_c1000001-0000-4000-8000-000000000005",
      "type": "person",
      "kind": "medic",
      "name": "Tomas Reed",
      "summary": "Tomas Reed treats injuries at the Second Watch Clinic.",
      "details": "Tomas keeps the clinic open through the night watch. He treats crews without asking for a port id, and he remembers who came in hurt. Hook: last night a dock worker had a scout seal in his pocket and would not give a name. The seal is still in a drawer.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
