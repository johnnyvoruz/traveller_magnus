      "updatedAt": "2026-10-14T00:00:00.000Z",
      "deleted": false
    },
    {
      "id": "cr_c1000001-0000-4000-8000-000000000004",
      "type": "person",
      "kind": "clerk",
      "name": "Nia Calder",
      "summary": "Nia Calder checks passes at the naval gate beside the highport.",
      "details": "Nia knows which passes are real. She will not stop a crew in the concourse. Hook: a naval pass was used twice today, and the second use was at Harun Pell's desk. She wants a quiet name, not an arrest.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
