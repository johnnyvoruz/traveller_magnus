    {
      "id": "cr_c1000001-0000-4000-8000-000000000007",
      "type": "person",
      "kind": "docker",
      "name": "Bram Keller",
      "summary": "Bram Keller moves crates between the lockers and the berths.",
      "details": "Bram works the night shift for whoever pays the locker fee. He can put a crate on a ship without a desk signature. Hook: he already moved Harun's sealed crate into a locker near The Quiet Lock. The locker is still rented under a name he will not say in the hall.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
