    {
      "id": "cr_c1000001-0000-4000-8000-00000000000c",
      "type": "place",
      "kind": "hall",
      "name": "Gallery C",
      "summary": "Gallery C is the public waiting hall of the Regina highport concourse.",
      "details": "Crews, brokers and base staff use this hall. Regina is an amber world, so visitors are warned to be on their guard. The chart lists an excellent starport, a naval base and a scout base, and it calls the world a satellite and an economic powerhouse with advanced technology.",
      "tags": [],
