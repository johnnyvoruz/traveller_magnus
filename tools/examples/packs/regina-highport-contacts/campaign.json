  "records": [
    {
      "id": "cr_c1000001-0000-4000-8000-000000000001",
      "type": "person",
      "kind": "broker",
      "name": "Sera Quill",
      "summary": "Sera Quill books cargo space from a desk in Gallery C.",
      "details": "Sera keeps the live list of berths that are free tonight. She will place a crew on a short haul if they can leave within a day. She does not name the sender of a crate in the hall. Hook: the sender of Harun Pell's sealed crate told her not to log its mass, and the sender used a naval gate pass. She tells a referee, not a crew.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
      "when": null,
      "visibility": "players",
      "playerNotes": null,
