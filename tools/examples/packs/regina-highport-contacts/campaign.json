    {
      "id": "cr_c1000001-0000-4000-8000-000000000006",
      "type": "person",
      "kind": "owner",
      "name": "Laleh Voss",
      "summary": "Laleh Voss runs The Amber Berth on Gallery C.",
      "details": "Laleh feeds brokers and off-duty base staff. She will hold a table and repeat what she heard, if the crew eats. She does not store cargo. Hook: Ivo Marsh left a written berth number under a plate. She has it, and she has not chosen who should receive it.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
