      "deleted": false
    },
    {
      "id": "cr_c1000001-0000-4000-8000-000000000002",
      "type": "person",
      "kind": "owner",
      "name": "Harun Pell",
      "summary": "Harun Pell owns Pell Freight Desk and signs the berth sheets.",
      "details": "Harun stays in the office behind Gallery C and checks seals, not people. He will hire a crew to move one sealed crate off Regina this week. He calls it machine parts. Hook: the seal is a scout-base pattern, and he has no scout receipt. He wants the crew gone before the next watch asks.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
      "when": null,
      "visibility": "players",
      "playerNotes": null,
