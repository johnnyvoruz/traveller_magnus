    {
      "id": "cr_c1000001-0000-4000-8000-00000000000d",
      "type": "place",
      "kind": "room",
      "name": "The Quiet Lock",
      "summary": "The Quiet Lock is a rented room off the concourse lockers.",
      "details": "The room is not on the public directory. Odette Parr meets people here. A locker nearby holds a sealed crate Bram Keller moved for Pell Freight Desk.",
