    {
      "id": "cr_c2000001-0000-4000-8000-00000000000b",
      "type": "job",
      "kind": "passage",
      "name": "The amber exit",
      "summary": "Take one passenger off Esalin on the next ship out.",
      "details": "Maris Ode has a passenger who must leave before the port stops issuing departures. Esalin is an amber world, so visitors are warned to be on their guard. It is dedicated to farming and is an economic powerhouse, with a population too low for an extensive industrial base. The starport is a routine one. Pay: the referee's call.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1004"
      },
      "when": null,
      "visibility": "players",
