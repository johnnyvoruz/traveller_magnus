    {
      "id": "cr_c2000001-0000-4000-8000-000000000006",
      "type": "person",
      "kind": "courier",
      "name": "Yara Tesh",
      "summary": "Yara Tesh carries messages for a house on Riverland.",
      "details": "Yara needs a sealed letter taken to a desk at the Jewell starport. She asks that it stay unopened. Hook: the letter names a passenger who is trying to leave Esalin. She tells a referee, not the crew.",
      "tags": [],
      "anchor": {
