    {
      "id": "cr_c2000001-0000-4000-8000-000000000003",
      "type": "person",
      "kind": "clerk",
      "name": "Petra Lang",
      "summary": "Petra Lang files berth cards at the scout base on Emerald.",
      "details": "Petra can say which ships the scout base is still expecting. One card is still open and the berth is empty. Hook: she wants the name of who cleared that berth, and she has not asked her chief.",
      "tags": [],
      "anchor": {
