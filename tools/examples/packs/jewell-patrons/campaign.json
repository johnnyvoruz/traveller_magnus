    {
      "id": "cr_c2000001-0000-4000-8000-00000000000e",
      "type": "event",
      "kind": "connection",
      "name": "The ship that skipped",
      "summary": "The ship missing from Emerald was last logged at Ruby.",
      "details": "Petra Lang's empty berth and Kenzo Hale's missing suit meet here. The ship that left Emerald took the suit at Ruby and has not filed a new berth. Use this when the crew asks either clerk where the ship went.",
