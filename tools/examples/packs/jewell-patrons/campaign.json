    {
      "id": "cr_c2000001-0000-4000-8000-000000000002",
      "type": "person",
      "kind": "factor",
      "name": "Colm Asher",
      "summary": "Colm Asher keeps the harvest books for a farming estate on Mongo.",
      "details": "Colm wants a tally book that left on a ship. He will hire the crew who can bring it back unread by the port. Hook: the book was packed in a sealed crate, and he does not know which ship took it.",
      "tags": [],
      "anchor": {
