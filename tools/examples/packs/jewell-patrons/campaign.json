    {
      "id": "cr_c2000001-0000-4000-8000-000000000005",
      "type": "person",
      "kind": "broker",
      "name": "Maris Ode",
      "summary": "Maris Ode sells passages on Esalin.",
      "details": "Maris has one passenger who must leave on the next ship. She will pay the crew's berth fee in a favor she names later. Hook: she will not name the danger, and she will deny the talk if anyone from the port is listening.",
      "tags": [],
      "anchor": {
