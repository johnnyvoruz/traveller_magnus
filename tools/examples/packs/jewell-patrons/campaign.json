    {
      "id": "cr_c2000001-0000-4000-8000-000000000001",
      "type": "person",
      "kind": "clerk",
      "name": "Adele Quinn",
      "summary": "Adele Quinn works the freight window at the Jewell starport.",
      "details": "Adele clears crates that the naval office has already seen once. She is hiring a ship for one crate she does not want opened again. Hook: she will not say what is inside, and she will end the talk if a naval clerk walks up.",
      "tags": [],
      "anchor": {
