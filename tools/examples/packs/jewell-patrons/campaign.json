    {
      "id": "cr_c2000001-0000-4000-8000-00000000000c",
      "type": "job",
      "kind": "delivery",
      "name": "The Riverland letter",
      "summary": "Carry a sealed letter from Riverland to a desk at Jewell.",
      "details": "Yara Tesh wants the letter delivered unopened. Riverland is an amber world, so visitors are warned to be on their guard, and the population is in the billions. The chart lists the Zhodani Consulate as its allegiance. The desk at Jewell is the one Adele Quinn works. Pay: the referee's call.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1102"
      },
