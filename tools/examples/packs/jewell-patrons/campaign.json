    {
      "id": "cr_c2000001-0000-4000-8000-00000000000a",
      "type": "job",
      "kind": "recovery",
      "name": "The missing suit",
      "summary": "Return a vacuum suit to the Ruby port before the next count.",
      "details": "Kenzo Hale is one suit short. Ruby has no atmosphere, the population is too low for an extensive industrial base, and a scout base is present. The missing suit carried a scout seal on the tag. Bring it back before his chief counts the locker. Pay: the referee's call.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1005"
