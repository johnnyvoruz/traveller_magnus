    {
      "id": "cr_c2000001-0000-4000-8000-00000000000d",
      "type": "event",
      "kind": "connection",
      "name": "One crate, two books",
      "summary": "The Jewell crate and the Mongo tally are the same shipment.",
      "details": "The sealed crate Adele Quinn wants moved is the box that held Colm Asher's harvest tally. Opening either one answers the other job. Use this when the crew reaches Mongo, or when they inspect the crate.",
      "tags": [],
