      "deleted": false
    },
    {
      "id": "cr_c2000001-0000-4000-8000-000000000008",
      "type": "job",
      "kind": "recovery",
      "name": "The harvest tally",
      "summary": "Bring a missing harvest tally back to Mongo unread by the port.",
      "details": "Colm Asher's tally book left the estate on a ship. Mongo is a farming economic powerhouse, with a population too low for an extensive industrial base, and it has a naval base and a scout base. He wants the book back before the port logs it. Pay: the referee's call.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1204"
      },
      "when": null,
