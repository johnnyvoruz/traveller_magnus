    {
      "id": "cr_c2000001-0000-4000-8000-000000000004",
      "type": "person",
      "kind": "keeper",
      "name": "Kenzo Hale",
      "summary": "Kenzo Hale issues vacuum suits at the Ruby port.",
      "details": "Kenzo counts the suits at the end of each shift. One suit left his locker with a scout seal on the tag. Hook: he wants it back before his chief counts them, and he will not file a loss if the crew returns it quietly.",
      "tags": [],
      "anchor": {
