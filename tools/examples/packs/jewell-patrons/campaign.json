    {
      "id": "cr_c2000001-0000-4000-8000-000000000007",
      "type": "job",
      "kind": "delivery",
      "name": "The unlogged crate",
      "summary": "Carry a sealed crate from Jewell to Mongo without a second inspection.",
      "details": "Adele Quinn has a crate the naval office cleared once. She wants it on a ship to Mongo before that office looks again. Jewell is an industrial world of billions, with advanced technology, an excellent starport, a naval base and a scout base. Do not open the crate in front of her. Pay: the referee's call.",
      "tags": [],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1106"
      },
      "when": null,
      "visibility": "players",
      "playerNotes": null,
