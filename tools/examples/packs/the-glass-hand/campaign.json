    },
    {
      "id": "cr_e1000000-0000-4000-8000-000000000028",
      "type": "note",
      "kind": "rumour",
      "name": "The door with no name",
      "summary": "Dock talk at Efate names a warehouse door with no sign.",
      "details": "Crews at Efate's excellent port say one berth on warehouse row never posts a name or a rate. Parcels go in after dark and leave within two days. Efate places no restrictions on a warehouse, so the talk is curiosity, not a charge. No one has opened a parcel and admitted it.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1705"
      },
      "when": null,
