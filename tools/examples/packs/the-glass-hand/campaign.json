    {
      "id": "cr_e1000000-0000-4000-8000-000000000026",
      "type": "place",
      "kind": "cabin",
      "name": "Green Cabin",
      "summary": "A sealed cabin on Whanga, away from the frontier port.",
      "details": "Whanga has few people and a frontier starport. The cabin is a short walk from the pad and is kept sealed. Odile Venn meets one visitor at a time. The world's restrictions are heavy, so visitors do not advertise the cabin.",
      "tags": [
        "example"
      ],
