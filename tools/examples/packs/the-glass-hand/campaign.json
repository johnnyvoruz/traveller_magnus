  "records": [
    {
      "id": "cr_e1000000-0000-4000-8000-00000000001d",
      "type": "organization",
      "kind": "ring",
      "name": "The Glass Hand",
      "summary": "A quiet ring that moves sealed parcels between four Regina-subsector worlds.",
      "details": "The Glass Hand is Wynn Solas's ring. The public face is Lantern Chandlery at Regina, where monitoring is heavy, so nothing questionable sits on the shelf. Staging is a nameless warehouse at Efate, which places no restrictions. A cabin at Whanga and a lookout at Dentus complete the circuit. They want a crew that can carry one sealed parcel and not open it. What the parcel is, and what it pays, is the referee's call.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
      "when": null,
      "visibility": "referee",
