    {
      "id": "cr_e1000000-0000-4000-8000-000000000023",
      "type": "person",
      "kind": "lookout",
      "name": "Harun Peck",
      "summary": "Watches scout traffic at Dentus for the Glass Hand.",
      "details": "Harun Peck works the routine port at Dentus, which has a scout base and places no restrictions. He notes which scout ships arrive and which leave with a blank log line. He wants those notes to reach Wynn Solas and no one else.",
      "tags": [
        "example"
