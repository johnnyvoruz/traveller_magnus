    {
      "id": "cr_e1000000-0000-4000-8000-000000000027",
      "type": "note",
      "kind": "rumour",
      "name": "Letters with no address",
      "summary": "Crews hear that a Regina chandlery takes letters for people who never shop.",
      "details": "Dock talk at Regina says Lantern Chandlery will hold a letter for a name that is not on any berth list. The staff call them customers who travel. No one at the port has called this a crime. A crew that asks too directly is told the drawer is full.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
