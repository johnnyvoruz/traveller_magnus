    },
    {
      "id": "cr_e1000000-0000-4000-8000-000000000025",
      "type": "place",
      "kind": "warehouse",
      "name": "Unmarked berth, warehouse row",
      "summary": "A warehouse berth at Efate with no name on the door.",
      "details": "The berth sits in Efate's industrial port, among many like it. Efate has an excellent starport, a high population and no restrictions on what a warehouse may hold. The Glass Hand stages sealed parcels here for a day or two. There is no sign and no published rate.",
      "tags": [
        "example"
      ],
