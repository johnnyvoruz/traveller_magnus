    {
      "id": "cr_e1000000-0000-4000-8000-000000000022",
      "type": "person",
      "kind": "courier",
      "name": "Odile Venn",
      "summary": "Keeps a sealed cabin on Whanga for one visitor at a time.",
      "details": "Odile Venn lives at the Green Cabin, a short walk from Whanga's frontier port. The world has few people, and she wants it to stay that way. She meets one courier at a time and turns the rest away.",
      "tags": [
        "example"
      ],
