      "deleted": false
    },
    {
      "id": "cr_e1000000-0000-4000-8000-00000000001f",
      "type": "person",
      "kind": "clerk",
      "name": "Ivo Tarn",
      "summary": "Clerk at Lantern Chandlery.",
      "details": "Ivo Tarn keeps the shelves and the letter drawer at Lantern Chandlery. He wants the drawer emptied on time and no questions from the port. He tells crews the letters are for customers who travel.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
