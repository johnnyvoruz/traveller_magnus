    {
      "id": "cr_e1000000-0000-4000-8000-000000000024",
      "type": "place",
      "kind": "chandlery",
      "name": "Lantern Chandlery",
      "summary": "A small chandlery on Regina's port concourse.",
      "details": "Lantern Chandlery sells lamps, seals and hand tools. Crews know it as a place to buy a fitting and leave a letter. The shelves hold nothing a port clerk would question. Regina's port monitors traffic closely, and the shop is built to pass that look.",
      "tags": [
        "example"
      ],
      "anchor": {
