    },
    {
      "id": "cr_e1000000-0000-4000-8000-000000000021",
      "type": "person",
      "kind": "courier",
      "name": "Edric Holm",
      "summary": "Moves sealed parcels through an unmarked berth at Efate.",
      "details": "Edric Holm works the unmarked warehouse berth at Efate. He wants parcels in and out within two days and no name on the door. He does not know what is in them, and he does not ask Wynn Solas.",
      "tags": [
        "example"
      ],
