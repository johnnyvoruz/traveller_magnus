    },
    {
      "id": "cr_e1000000-0000-4000-8000-000000000020",
      "type": "person",
      "kind": "clerk",
      "name": "Nessa Holt",
      "summary": "Door clerk at Lantern Chandlery.",
      "details": "Nessa Holt watches who comes into Lantern Chandlery and how long they stay. She wants the shop to look like any other fitting shop on Regina's concourse. She remembers faces and does not write them down.",
      "tags": [
        "example"
      ],
      "anchor": {
