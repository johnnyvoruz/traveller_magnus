    },
    {
      "id": "cr_e1000000-0000-4000-8000-00000000001e",
      "type": "person",
      "kind": "chandler",
      "name": "Wynn Solas",
      "summary": "Owner of Lantern Chandlery at Regina's port.",
      "details": "Wynn Solas sells lamps, seals and small tools to crews who berth at Regina. She wants regular customers and a reputation for exact change. She takes letters for people who do not come into the shop. She does not talk about where those letters go.",
      "tags": [
        "example"
      ],
      "anchor": {
        "kind": "system",
        "hexKey": "Spinward_Marches/1910"
      },
      "when": null,
      "visibility": "players",
